# Full OpenAI-compatible Chat Completions URL for a server you run or trust.
MODEL_API_URL=http://127.0.0.1:11434/v1/chat/completions
MODEL_ID=your-installed-model
MODEL_API_KEY=

# Optional. Off by default because not all servers support function tools.
ASK_ENABLE_FILE_TOOLS=false
ASK_MAX_READ_CHARS=20000
